#
# Rebuild a throwaway `review` branch by merging every cleanly-mergeable feature
# branch on top of main, so one instance can show the combined work. Branches that
# conflict are skipped and reported; nothing is pushed. The review worktree lives
# at .worktrees/review and appears automatically in `just review`.
#
# Usage: pgrep-sync-review [branch ...]   (default: all local feat/* branches)
set -euo pipefail

# Always operate from the primary checkout, even when this script (or
# `just review-sync`) is invoked from a feature worktree. Otherwise
# REVIEW_WT resolves under the worktree and `git worktree add review` fails
# with "already used by worktree at …/.worktrees/review".
GIT_COMMON_DIR="$(git rev-parse --path-format=absolute --git-common-dir)"
case "$GIT_COMMON_DIR" in
  */.git) ROOT_DIR="${GIT_COMMON_DIR%/.git}" ;;
  *)
    echo "ERROR: cannot derive primary checkout from Git common dir: $GIT_COMMON_DIR" >&2
    exit 1
    ;;
esac
cd "$ROOT_DIR"

if "$ROOT_DIR/tools/pgrep_worktrees.py" review-disk-guard; then
  :
else
  status=$?
  if [ "$status" -eq 2 ]; then
    exit 75
  fi
  exit "$status"
fi

REVIEW_LOCK="$GIT_COMMON_DIR/pgrep-review-operation.lock"
if ! mkdir "$REVIEW_LOCK" 2>/dev/null; then
  owner="owner unknown"
  for owner_file in "$REVIEW_LOCK"/owner "$REVIEW_LOCK"/owner.*; do
    if [ -r "$owner_file" ]; then
      owner="$(<"$owner_file")"
      break
    fi
  done
  echo "ERROR: active review operation lock at $REVIEW_LOCK ($owner)." >&2
  echo "Stop the owner, or if stale, verify no review sync/clean is running before removing the lock manually." >&2
  exit 1
fi
LOCK_TOKEN="$(python3 -c 'import secrets; print(secrets.token_hex(16))')"
LOCK_OWNER_RECORD="sync pid=$$ token=$LOCK_TOKEN"
LOCK_OWNER_FILE="$REVIEW_LOCK/owner.$LOCK_TOKEN"
printf '%s' "$LOCK_OWNER_RECORD" > "$LOCK_OWNER_FILE"
release_review_lock() {
  if [ -r "$LOCK_OWNER_FILE" ]; then
    current_owner="$(<"$LOCK_OWNER_FILE")"
    current_size="$(wc -c < "$LOCK_OWNER_FILE")"
    if [ "$current_owner" = "$LOCK_OWNER_RECORD" ] && [ "$current_size" -eq "${#LOCK_OWNER_RECORD}" ]; then
      rm -f "$LOCK_OWNER_FILE"
      rmdir "$REVIEW_LOCK" 2>/dev/null || true
    fi
  fi
}
trap release_review_lock EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

REVIEW_WT="$ROOT_DIR/.worktrees/review"
BASE="${PGREP_REVIEW_BASE:-main}"

branches=()
if [ "$#" -gt 0 ]; then
  branches=("$@")
else
  while IFS= read -r b; do branches+=("$b"); done \
    < <(git for-each-ref --format='%(refname:short)' refs/heads/feat/)
fi

# Create the review branch and worktree on first run.
if ! git show-ref --verify --quiet refs/heads/review; then
  git branch review "$BASE"
fi
if [ ! -d "$REVIEW_WT" ]; then
  git worktree add "$REVIEW_WT" review >/dev/null
fi

# Start clean from the base each run.
git -C "$REVIEW_WT" reset --hard "$BASE" >/dev/null
git -C "$REVIEW_WT" clean -fd >/dev/null

merged=()
skipped=()
for b in "${branches[@]}"; do
  [ "$b" = "review" ] && continue
  if git -C "$REVIEW_WT" merge --no-edit --no-ff "$b" >/dev/null 2>&1; then
    merged+=("$b")
  else
    git -C "$REVIEW_WT" merge --abort >/dev/null 2>&1 || true
    skipped+=("$b")
  fi
done

echo "Review branch rebuilt on ${BASE}."
echo "  merged  (${#merged[@]}): ${merged[*]:-none}"
echo "  skipped (${#skipped[@]}, conflicts): ${skipped[*]:-none}"
echo

# Merging feat branches can leave uv.lock inconsistent with pyproject (git merge
# keeps one side). Refresh the lock so `./run` / Start on the dashboard can boot.
if [ -x "$REVIEW_WT/out/extracted/uv/uv" ]; then
  echo "Refreshing uv.lock in ${REVIEW_WT}..."
  if (cd "$REVIEW_WT" && ./out/extracted/uv/uv lock) >/dev/null 2>&1; then
    echo "  uv.lock refreshed."
  else
    echo "  uv lock failed (Start may fail until you run it by hand in ${REVIEW_WT})."
  fi
fi

# Rebuild the web bundle in the review worktree so a running headless instance
# (and its live-reload token) picks up UI changes without a process restart.
# Serialize with the same lock web-watch uses so we never race concurrent ninja.
# Python/backend changes still need a Stop/Start on the review dashboard.
if [ -x "$REVIEW_WT/ninja" ] || [ -x "$REVIEW_WT/./ninja" ]; then
  echo "Rebuilding web in ${REVIEW_WT}..."
  LOCK_ROOT="${TMPDIR:-/tmp}/pgrep-web-watch-locks"
  mkdir -p "$LOCK_ROOT"
  LOCK_DIR="$LOCK_ROOT/$(cd "$REVIEW_WT" && pwd | shasum -a 256 | awk '{print $1}').d"
  if mkdir "$LOCK_DIR" 2>/dev/null; then
    if (cd "$REVIEW_WT" && ./ninja qt) >/dev/null 2>&1; then
      echo "  web rebuilt (browser tabs polling the reload token will refresh)."
    else
      echo "  web rebuild skipped/failed (run \`./ninja qt\` in ${REVIEW_WT} if needed)."
    fi
    rmdir "$LOCK_DIR" 2>/dev/null || true
  else
    echo "  web rebuild deferred (watcher already rebuilding; tab will refresh when it finishes)."
  fi
fi

echo
echo "It shows up as the 'review' row in the dashboard (just review). Start it there,"
echo "or run \`just dev\` from ${REVIEW_WT}. Restart the instance after a re-sync if"
echo "you need Python/backend changes (web-only changes auto-refresh)."
